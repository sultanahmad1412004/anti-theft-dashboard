rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'sultanahmad.real1@gmail.com'
      );
    }
    
    function isSuperAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin') ||
        request.auth.token.email == 'sultanahmad.real1@gmail.com'
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }
    
    // Users collection and subcollections
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
      
      match /devices/{deviceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow read: if isAdmin();
        allow write: if request.auth != null && request.auth.uid == userId;
        allow write: if isAdmin();
      }
    }

    // Collection group query support for multi-device fleet & live activity radar
    match /{path=**}/devices/{deviceId} {
      allow read, write: if isAdmin();
    }
    
    // Guest users
    match /guest_users/{guestId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
